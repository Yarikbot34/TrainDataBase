<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8"/>
    <meta name="viewport" content="width=device-width, initial-scale=1.0"/>
    <title>@ViewData["Title"] - WEB</title>
    <script type="importmap"></script>
    <link rel="stylesheet" href="~/lib/bootstrap/dist/css/bootstrap.min.css"/>
    <link rel="stylesheet" href="~/css/site.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/WEB.styles.css" asp-append-version="true"/>
    <link rel="stylesheet" href="~/css/sidebar.css" asp-append-version="true"/>
</head>
<body>
    @{
    var currentPath = Context.Request.Path.Value?.ToLowerInvariant() ?? "/";
    var isHomeActive = currentPath == "/";
    var isRoutesActive = currentPath.StartsWith("/TableView/Routes");
    var isImportActive = currentPath.StartsWith("/import");
}

<aside class="sidebar">
    <input class="sidebar__toggle-input"
           type="checkbox"
           id="sidebarMenuToggle"
           aria-label="Открыть или закрыть навигационное меню" />

    <div class="sidebar__logo">
        <div class="sidebar__logo-placeholder" aria-hidden="true">
            <svg viewBox="0 0 24 24">
                <path d="M12 2L2 7v10l10 5 10-5V7L12 2zm0 2.18l7 3.5v7.64l-7 3.5-7-3.5V7.68l7-3.5z" />
            </svg>
        </div>

        <div class="sidebar__logo-text">
            <strong>Маршруты</strong>
            <span>Система учёта</span>
        </div>

        <label class="sidebar__toggle"
               for="sidebarMenuToggle"
               title="Навигационное меню"
               aria-label="Открыть или закрыть навигационное меню">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 18h18v-2H3v2zm0-5h18v-2H3v2zm0-7v2h18V6H3z" />
            </svg>
        </label>
    </div>

    <nav class="sidebar__navigation" aria-label="Основная навигация">
        <div class="sidebar__section-title">Навигация</div>

        <a class="navigation-item @(isHomeActive ? "active" : "")"
           href="/">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M10 20v-6h4v6h5v-8h3L12 3 2 12h3v8z" />
            </svg>
            <span>Главная</span>
        </a>

        <a class="navigation-item @(isRoutesActive ? "active" : "")"
           href="/TableView/Routes">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M3 13h2v-2H3v2zm0 4h2v-2H3v2zm0-8h2V7H3v2zm4 4h14v-2H7v2zm0 4h14v-2H7v2zm0-10v2h14V7H7z" />
            </svg>
            <span>Просмотр маршрутов</span>
        </a>

        <a class="navigation-item @(isImportActive ? "active" : "")"
           href="/Import">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M19 9h-4V3H9v6H5l7 7 7-7zM5 18v2h14v-2H5z" />
            </svg>
            <span>Импорт данных</span>
        </a>

        <span class="navigation-item navigation-item--disabled"
              aria-disabled="true">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M4 6H2v14c0 1.1.9 2 2 2h14v-2H4V6zm16-4H8c-1.1 0-2 .9-2 2v12c0 1.1.9 2 2 2h12c1.1 0 2-.9 2-2V4c0-1.1-.9-2-2-2zm-1 9H9V9h10v2zm-4 4H9v-2h6v2zm4-8H9V5h10v2H9V5z" />
            </svg>
            <span>Справочники</span>
        </span>
    </nav>

    <div class="sidebar__footer">
        <div>База данных маршрутов</div>
        <div>Табличные данные / Маршруты</div>
    </div>
</aside>
<div class="container">
    <main role="main" class="pb-3">
        @RenderBody()
    </main>
</div>

<footer class="border-top footer text-muted">
    <div class="container">
        &copy; 2026 - WEB - <a asp-area="" asp-page="/Privacy">Privacy</a>
    </div>
</footer>

<script src="~/lib/jquery/dist/jquery.min.js"></script>
<script src="~/lib/bootstrap/dist/js/bootstrap.bundle.min.js"></script>
<script src="~/js/site.js" asp-append-version="true"></script>

@await RenderSectionAsync("Scripts", required: false)
</body>
</html>