@page
@{
    ViewData["Title"] = "Просмотр маршрутов";
}

<div class="routes-page" id="routesPage">
    <header class="page-header">
        <div>
            <div class="breadcrumbs">
                <span>База данных маршрутов</span>
                <span>/</span>
                <strong>Просмотр маршрутов</strong>
            </div>

            <h1>Просмотр маршрутов</h1>
            <p>Сводные данные по перевозкам пассажиров и доходам</p>
        </div>

        <button class="refresh-button" id="refreshButton" type="button">
            <svg viewBox="0 0 24 24" aria-hidden="true">
                <path d="M17.65 6.35C16.2 4.9 14.21 4 12 4c-4.42 0-7.99 3.58-7.99 8s3.57 8 7.99 8c3.73 0 6.84-2.55 7.73-6h-2.08c-.82 2.33-3.04 4-5.65 4-3.31 0-6-2.69-6-6s2.69-6 6-6c1.66 0 3.14.69 4.22 1.78L13 11h7V4l-2.35 2.35z" />
            </svg>
            <span>Обновить</span>
        </button>
    </header>

    <div class="workspace" id="workspace">
        <section class="workspace__main" aria-label="Таблица маршрутов">
            <div class="table-card">
                <div class="table-card__toolbar">
                    <div>
                        <h2>Маршруты</h2>
                        <p id="recordsCounter">Загрузка данных…</p>
                    </div>

                    <div class="search-field">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M15.5 14h-.79l-.28-.27C15.41 12.59 16 11.11 16 9.5 16 5.91 13.09 3 9.5 3S3 5.91 3 9.5 5.91 16 9.5 16c1.61 0 3.09-.59 4.23-1.57l.27.28v.79l5 4.99L20.49 19l-4.99-5zm-6 0C7.01 14 5 11.99 5 9.5S7.01 5 9.5 5 14 7.01 14 9.5 11.99 14 9.5 14z" />
                        </svg>

                        <input id="searchInput"
                               type="search"
                               placeholder="Поиск маршрута"
                               autocomplete="off" />
                    </div>
                </div>
                
                <div class="filters-bar" id="filtersBar" aria-label="Фильтры маршрутов">
                    <button class="filters-reset-button"
                            id="resetFiltersButton"
                            type="button"
                            title="Сбросить все фильтры">
                        <svg viewBox="0 0 24 24" aria-hidden="true">
                            <path d="M12 5V1L7 6l5 5V7c3.31 0 6 2.69 6 6s-2.69 6-6 6-6-2.69-6-6H4c0 4.42 3.58 8 8 8s8-3.58 8-8-3.58-8-8-8z" />
                        </svg>
                        <span>Сбросить фильтры</span>
                    </button>
                </div>

                <div class="table-container">
                    <table class="routes-table">
                        <thead>
                            <tr class="group-header">
                                <th class="sticky-column sticky-column--year" rowspan="2">Год</th>
                                <th class="sticky-column sticky-column--month" rowspan="2">Месяц</th>
                                <th class="sticky-column sticky-column--route" rowspan="2">
                                    № поездов<br />«туда-обратно»
                                </th>
                                <th colspan="5">Количество перевезённых пассажиров, чел.</th>
                                <th colspan="5">Средняя дальность поездки, км</th>
                                <th colspan="5">Доходы от перевозки пассажиров, руб.</th>
                                <th colspan="4">Доходы от субъектов, установивших льготы, руб.</th>
                            </tr>

                            <tr class="column-header">
                                <th><span>Пассажиры, не имеющие льгот</span></th>
                                <th><span>Обучающиеся</span></th>
                                <th><span>Федеральные льготники</span></th>
                                <th><span>Региональные льготники</span></th>
                                <th><span>Иные пассажиры</span></th>

                                <th><span>Пассажиры, не имеющие льгот</span></th>
                                <th><span>Обучающиеся</span></th>
                                <th><span>Федеральные льготники</span></th>
                                <th><span>Региональные льготники</span></th>
                                <th><span>Иные пассажиры</span></th>

                                <th><span>Пассажиры, не имеющие льгот</span></th>
                                <th><span>Обучающиеся</span></th>
                                <th><span>Федеральные льготники</span></th>
                                <th><span>Региональные льготники</span></th>
                                <th><span>Иные пассажиры</span></th>

                                <th><span>Обучающиеся</span></th>
                                <th><span>Федеральные льготники</span></th>
                                <th><span>Региональные льготники</span></th>
                                <th><span>Иные пассажиры</span></th>
                            </tr>
                        </thead>

                        <tbody id="routesTableBody">
                            <tr>
                                <td class="state-cell" colspan="22">
                                    <div class="loading-state">
                                        <span class="spinner" aria-hidden="true"></span>
                                        <span>Загрузка маршрутов…</span>
                                    </div>
                                </td>
                            </tr>
                        </tbody>
                    </table>
                </div>

                <div class="table-information">
                    <div class="table-information__accent"></div>
                    <span>
                        Для просмотра всех столбцов используйте горизонтальную прокрутку.
                        Нажмите на номер поезда, чтобы открыть список поездов.
                    </span>
                </div>
            </div>
        </section>

        <aside class="workspace__details" id="detailsPanel" aria-label="Данные по поездам">
            <div class="details-panel__header">
                <div>
                    <span class="details-panel__caption">Данные по поездам</span>
                    <h2 id="selectedRouteTitle">Поезда не выбраны</h2>
                    <p class="details-panel__counter" id="trainsCounter">Выберите номер поезда в верхней таблице</p>
                </div>

                <button class="icon-button"
                        id="closeDetailsButton"
                        type="button"
                        title="Закрыть панель"
                        aria-label="Закрыть панель">
                    <svg viewBox="0 0 24 24" aria-hidden="true">
                        <path d="M18.3 5.71 16.89 4.3 12 9.17 7.11 4.3 5.7 5.71 10.59 10.59 5.7 15.48l1.41 1.41L12 12l4.89 4.89 1.41-1.41-4.89-4.89 4.89-4.88z" />
                    </svg>
                </button>
            </div>

            <div class="trains-table-container">
                <table class="trains-table">
                    <thead>
                        <tr>
                            <th>№ поезда</th>
                            <th>Станция отправления — станция назначения</th>
                            <th>Время отправления и прибытия по конечным станциям</th>
                            <th>Расстояние между станциями, км</th>
                            <th>Количество вагонов, ед.</th>
                            <th>Вагоно-километры в сутки</th>
                            <th>Количество дней курсирования</th>
                            <th>Вагоно-километры в месяц</th>
                            <th>Доп. данные</th>
                        </tr>
                    </thead>

                    <tbody id="trainsTableBody">
                        <tr>
                            <td class="trains-state-cell" colspan="9">
                                Выберите номер поезда в верхней таблице.
                            </td>
                        </tr>
                    </tbody>
                </table>
            </div>
        </aside>
    </div>
</div>

<div class="notification" id="notification" role="status" aria-live="polite"></div>

@section Scripts {
    <script src="~/js/routes.js" asp-append-version="true"></script>
}