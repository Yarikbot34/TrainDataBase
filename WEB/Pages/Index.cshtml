@page
@model WebApplication1.Pages.StatisticsModel;
@{
    ViewData["Title"] = "Быстрая статистика";
}

<div class="stats-page" data-default-year="@Model.DefaultYear">
    <div class="page-header">
        <div>
            <nav class="breadcrumbs">
                <a href="/">Главная</a> / <strong>Быстрая статистика</strong>
            </nav>
            <h1>Быстрая статистика</h1>
            <p>Пассажиропоток и доходы по месяцам за выбранный год. Для текущего года показываются последние 12 месяцев.</p>
        </div>
    </div>
    
    <section class="stats-card" data-kind="passengers">
        <header class="stats-card__header">
            <div>
                <h2>Пассажиропоток</h2>
                <p>Пассажиры в год (по месяцам)</p>
            </div>
        </header>

        <div class="stats-card__toolbar">
            <div class="stats-year-field">
                <label for="passengers-year">Год</label>
                <select id="passengers-year" class="stats-year-select" aria-label="Год пассажиропотока"></select>
            </div>
            <div class="stats-view-switch" role="group" aria-label="Вид блока пассажиропотока">
                <button type="button" class="stats-view-btn is-active" data-view="both">График + Таблица</button>
                <button type="button" class="stats-view-btn" data-view="table">Таблица</button>
                <button type="button" class="stats-view-btn" data-view="chart">График</button>
            </div>
        </div>

        <div class="stats-card__content view-both">
            <div class="stats-card__chart">
                <div class="stats-chart" id="passengers-chart"></div>
            </div>
            <div class="stats-card__table">
                <div class="stats-table-container">
                    <table class="stats-table" id="passengers-table">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
    
    <section class="stats-card" data-kind="payment">
        <header class="stats-card__header">
            <div>
                <h2>Доходы</h2>
                <p>Доходы в год (по месяцам)</p>
            </div>
        </header>

        <div class="stats-card__toolbar">
            <div class="stats-year-field">
                <label for="payment-year">Год</label>
                <select id="payment-year" class="stats-year-select" aria-label="Год доходов"></select>
            </div>
            <div class="stats-view-switch" role="group" aria-label="Вид блока доходов">
                <button type="button" class="stats-view-btn is-active" data-view="both">График + Таблица</button>
                <button type="button" class="stats-view-btn" data-view="table">Таблица</button>
                <button type="button" class="stats-view-btn" data-view="chart">График</button>
            </div>
        </div>

        <div class="stats-card__content view-both">
            <div class="stats-card__chart">
                <div class="stats-chart" id="payment-chart"></div>
            </div>
            <div class="stats-card__table">
                <div class="stats-table-container">
                    <table class="stats-table" id="payment-table">
                        <thead></thead>
                        <tbody></tbody>
                    </table>
                </div>
            </div>
        </div>
    </section>
</div>

@section Scripts {
    <script src="https://cdn.jsdelivr.net/npm/apexcharts@3.54.1/dist/apexcharts.min.js"></script>
    <script src="~/js/index.js" asp-append-version="true"></script>
}