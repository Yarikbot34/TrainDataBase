@page "/map/editor"
@model MapEditorModel
@{
    ViewData["Title"] = "Конструктор схемы связей";
}

<div class="map-editor-page">
    <header class="page-header">
        <div>
            <nav class="breadcrumbs" aria-label="Хлебные крошки">
                <span>Главная</span> <span>/</span> <strong>Конструктор схемы</strong>
            </nav>
            <h1>Конструктор схемы связей станций</h1>
            <p>Добавляйте станции, соединяйте их линиями, задавайте нагрузку и сохраняйте схему на сервер.</p>
        </div>
    </header>

    <section class="editor-card">
        <div class="editor-toolbar">
            <div class="form-field">
                <label for="schema-name">Название схемы</label>
                <!-- Листбокс: пользователь вводит имя новой схемы,
                     а после реализации редактирования здесь же появится список сохранённых схем -->
                <input id="schema-name" list="saved-schemas" placeholder="Например: Схема 2026 года" autocomplete="off" />
                <datalist id="saved-schemas">
                    @* TODO: позже сюда будут подставляться сохранённые схемы для редактирования *@
                </datalist>
            </div>

            <div class="form-field">
                <label for="schema-description">Описание</label>
                <input id="schema-description" placeholder="Краткое описание (необязательно)" autocomplete="off" />
            </div>

            <div class="form-field">
                <label for="station-select">Добавить станцию</label>
                <div class="station-add">
                    <select id="station-select"></select>
                    <button id="add-station-btn" class="reset-button" type="button">Добавить</button>
                </div>
            </div>
        </div>

        <div class="editor-canvas">
            <div id="graph-container"></div>

            <div class="zoom-bar" role="toolbar" aria-label="Масштаб">
                <button class="icon-button" id="zoom-in-btn"    type="button" title="Приблизить">+</button>
                <button class="icon-button" id="zoom-out-btn"   type="button" title="Отдалить">−</button>
                <button class="icon-button" id="zoom-fit-btn"   type="button" title="Вписать всё">⛶</button>
                <button class="icon-button" id="zoom-reset-btn" type="button" title="Масштаб 100%">1:1</button>
            </div>

            <!-- Панель настройки связи (появляется по клику на линию) -->
            <div class="edge-panel" id="edge-panel" hidden>
                <span class="edge-panel__title">
                    Связь
                    <strong id="edge-panel-label"></strong>
                </span>
                <button id="edge-delete-btn" class="reset-button" type="button">Удалить</button>
            </div>
        </div>

        <div class="editor-actions">
            <button id="save-schema-btn" class="upload-button" type="button">
                <svg viewBox="0 0 24 24" aria-hidden="true">
                    <path d="M5 3h12l4 4v13a1 1 0 0 1-1 1H5a1 1 0 0 1-1-1V4a1 1 0 0 1 1-1zm2 2v4h9V5H7zm10 14v-7H7v7h10z"/>
                </svg>
                <span class="upload-button__text">Сохранить схему</span>
                <span class="upload-button__loading"><span class="spinner"></span>Сохранение…</span>
            </button>
            <button id="clear-canvas-btn" class="reset-button" type="button">Очистить</button>
        </div>

        <div class="table-information">
            <span class="table-information__accent"></span>
            <span>
                Перетаскивайте узлы мышью. Связь создаётся перетаскиванием от круглого порта узла к другому узлу.
                Клик по линии — настройка нагрузки (цвет и толщина меняются автоматически).
                Клавиша Delete — удаление.
            </span>
        </div>
    </section>
</div>

<div class="notification" id="map-notification" role="status"></div>

<script src="~/lib/x6/x6.min.js" asp-append-version="true"></script>
<script src="~/js/map-editor.js" asp-append-version="true"></script>